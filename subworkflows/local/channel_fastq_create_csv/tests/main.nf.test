nextflow_workflow {

    name "Test Workflow CHANNEL_FASTQ_CREATE_CSV"
    script "../main.nf"
    workflow "CHANNEL_FASTQ_CREATE_CSV"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "channel_fastq_create_csv"

    test("Should run without failures - rnaseq") {

        when {
            workflow {
                """
                input[0] = channel.of([[
                    id:'Sample1_S1_L001',
                    samplename:'Sample1',
                    fcid:'220422_M11111_0222_000000000-K9H97',
                    lane:'1',
                    empty:false,
                    single_end:true,
                    fastq_1:'Sample1_S1_L001_R1_001.fastq.gz',
                ]]).collect()
                input[1] = 'rnaseq'
                input[2] = 'auto'
                input[3] = "${outputDir}"
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(file(workflow.out.samplesheet.first()).text).match() }
            )
        }
    }

