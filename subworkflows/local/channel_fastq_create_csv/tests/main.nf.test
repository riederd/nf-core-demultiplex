                    fastq_1:'Sample1_S1_L001_R1_001.fastq.gz',
                    fastq_2:'Sample1_S1_L001_R2_001.fastq.gz',
                ]]).collect()
                input[1] = 'sarek'
                input[2] = ''
                input[3] = "${outputDir}"
                """
